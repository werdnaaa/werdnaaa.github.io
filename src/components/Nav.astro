---
/**
 * Fixed site header. Starts transparent when it sits over a video hero
 * (`overlay`), then fades to a solid blurred bar once the page scrolls.
 */
import { existsSync, readdirSync } from 'node:fs';
import { join } from 'node:path';
import { SITE } from '../site';

interface Props {
  overlay?: boolean;
}

/**
 * The player only renders if an audio file is actually present, so the nav
 * stays clean until one is added. First match wins.
 */
const findTrack = () => {
  const dir = join(process.cwd(), 'public', 'audio');
  if (!existsSync(dir)) return null;

  const file = readdirSync(dir)
    .sort()
    .find((name) => /\.(mp3|m4a|aac|ogg|wav)$/i.test(name));

  if (!file) return null;

  const fallbackTitle = file
    .replace(/\.[^.]+$/, '')
    .replace(/[-_]+/g, ' ')
    .trim();

  return {
    src: `/audio/${encodeURIComponent(file)}`,
    title: SITE.music?.title || fallbackTitle,
  };
};

const track = findTrack();

const { overlay = false } = Astro.props;

const links = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
  { href: '/projects/', label: 'Projects' },
  { href: '/fpv/', label: 'FPV Racing' },
  { href: '/fountains/', label: 'Fountains' },
  { href: '/gospel/', label: 'The Gospel' },
];

// Mark the current section so its nav item can be highlighted.
const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---

<header class:list={['nav', { 'nav--overlay': overlay }]} data-nav>
  <div class="nav__inner">
    <a class="nav__brand" href="/">
      <img
        class="nav__logo"
        src="/logo.png"
        alt=""
        width="110"
        height="96"
        decoding="async"
      />
      <span>WERDNAAA</span>
    </a>

    {
      track && (
        <div class="player" data-player>
          <button
            class="player__btn"
            type="button"
            aria-label={`Play ${track.title}`}
            aria-pressed="false"
            data-toggle
          >
            <svg class="player__icon player__icon--play" viewBox="0 0 16 16" aria-hidden="true">
              <path d="M4 2.5 L13 8 L4 13.5 Z" fill="currentColor" />
            </svg>
            <svg class="player__icon player__icon--pause" viewBox="0 0 16 16" aria-hidden="true">
              <rect x="4" y="2.5" width="3" height="11" rx="1" fill="currentColor" />
              <rect x="9" y="2.5" width="3" height="11" rx="1" fill="currentColor" />
            </svg>
          </button>

          <span class="player__disc" aria-hidden="true">
            <img src="/img/logos/newjeans.png" alt="" width="300" height="300" decoding="async" />
          </span>

          <span class="player__name">{track.title}</span>

          <audio data-audio src={track.src} data-title={track.title} loop preload="none"></audio>
        </div>
      )
    }

    <button
      class="nav__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="nav-menu"
      aria-label="Toggle navigation"
      data-nav-toggle
    >
      <span></span><span></span><span></span>
    </button>

    <nav class="nav__menu" id="nav-menu" aria-label="Primary">
      <ul>
        {links.map((link) => (
          <li>
            <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    height: var(--nav-h);
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid var(--line-soft);
    transition: background-color 0.35s var(--ease), border-color 0.35s var(--ease),
      color 0.35s var(--ease);
  }

  /* Transparent while sitting over a hero video, until .is-scrolled is set. */
  .nav--overlay:not(.is-scrolled) {
    background: transparent;
    backdrop-filter: none;
    border-bottom-color: transparent;
    color: #fff;
  }

  .nav--overlay:not(.is-scrolled) .nav__brand,
  .nav--overlay:not(.is-scrolled) .nav__menu a,
  .nav--overlay:not(.is-scrolled) .player {
    color: #fff;
  }

  .nav--overlay:not(.is-scrolled) .player {
    background: rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 255, 255, 0.28);
  }

  .nav--overlay:not(.is-scrolled) .nav__toggle span {
    background: #fff;
  }

  /* Safari below 18 only understands the prefixed property. A plain duplicate
     declaration gets pruned by the CSS minifier, so gate it behind @supports,
     which is treated as a feature query rather than a redundant repeat. */
  @supports (-webkit-backdrop-filter: blur(1px)) {
    .nav { -webkit-backdrop-filter: saturate(180%) blur(20px); }
    .nav--overlay:not(.is-scrolled) { -webkit-backdrop-filter: none; }
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    height: 100%;
    max-width: 1180px;
    margin-inline: auto;
    padding-inline: var(--gutter);
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    font-size: var(--step-0);
    font-weight: 700;
    letter-spacing: 0.22em;
  }

  /* Mark sits next to the wordmark, matched to the text height.
     This one value is the whole knob — raise or lower to taste. */
  .nav__logo {
    height: 1.5em;
    width: auto;
    flex: none;
  }

  /* ---- Nav music player ---- */

  .player {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
    padding: 0.25rem 0.7rem 0.25rem 0.3rem;
    color: var(--text);
    background: var(--bg-alt);
    border: 1px solid var(--line);
    border-radius: 100px;
    transition: background-color 0.35s var(--ease), border-color 0.35s var(--ease),
      color 0.35s var(--ease);
  }

  .player__btn {
    flex: none;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    padding: 0;
    color: inherit;
    background: none;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
  }

  .player__btn:hover { opacity: 0.7; }

  .player__icon {
    width: 13px;
    height: 13px;
  }

  /* One icon at a time, driven by the is-playing class. */
  .player__icon--pause,
  .player.is-playing .player__icon--play { display: none; }

  .player.is-playing .player__icon--pause { display: block; }

  /* Circular crop of the album art. The animation is always attached and
     simply paused, so toggling play resumes the rotation rather than
     snapping it back to zero. */
  .player__disc {
    position: relative;
    flex: none;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    overflow: hidden;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.12);
    animation: player-spin 3.5s linear infinite;
    animation-play-state: paused;
  }

  .player.is-playing .player__disc { animation-play-state: running; }

  .player__disc img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @keyframes player-spin {
    to { rotate: 360deg; }
  }

  .player__name {
    max-width: 15ch;
    overflow: hidden;
    font-size: var(--step--1);
    letter-spacing: 0.02em;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  @media (prefers-reduced-motion: reduce) {
    .player__disc { animation: none; }
  }

  /* Tight nav: keep the control, drop the label. */
  @media (max-width: 900px) {
    .player__name { display: none; }
    .player { padding-right: 0.35rem; }
  }

  .nav__menu ul {
    display: flex;
    gap: clamp(1.4rem, 3vw, 2.6rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__menu a {
    position: relative;
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    color: var(--text);
    opacity: 0.85;
    transition: opacity 0.2s var(--ease);
  }

  .nav__menu a:hover { opacity: 1; }

  .nav__menu a[aria-current='page'] {
    opacity: 1;
    font-weight: 700;
  }

  .nav__toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .nav__toggle span {
    display: block;
    height: 1.5px;
    width: 22px;
    margin-inline: auto;
    background: var(--text);
    transition: transform 0.28s var(--ease), opacity 0.28s var(--ease);
  }

  @media (max-width: 720px) {
    .nav__toggle { display: flex; }

    .nav__menu {
      position: fixed;
      inset: var(--nav-h) 0 auto;
      background: rgba(255, 255, 255, 0.97);
        backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--line-soft);
      transform: translateY(-12px);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s var(--ease), transform 0.25s var(--ease);
    }

    .nav__menu ul {
      flex-direction: column;
      gap: 0;
      padding: 0.5rem var(--gutter) 1.5rem;
    }

    .nav__menu li { border-bottom: 1px solid var(--line-soft); }
    .nav__menu li:last-child { border-bottom: 0; }

    .nav__menu a {
      display: block;
      padding: 1rem 0;
      font-size: var(--step-0);
      color: var(--text) !important;
    }

    @supports (-webkit-backdrop-filter: blur(1px)) {
      .nav__menu { -webkit-backdrop-filter: blur(20px); }
    }

    .nav.is-open .nav__menu {
      transform: none;
      opacity: 1;
      pointer-events: auto;
    }

    .nav.is-open .nav__toggle span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
    .nav.is-open .nav__toggle span:nth-child(2) { opacity: 0; }
    .nav.is-open .nav__toggle span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }
  }
</style>

<script>
  const nav = document.querySelector('[data-nav]');
  const toggle = document.querySelector('[data-nav-toggle]');

  if (nav && toggle) {
    toggle.addEventListener('click', () => {
      const open = nav.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(open));
    });
  }

  // ---- Music player ----
  const player = document.querySelector('[data-player]');
  const audio = player?.querySelector('audio');
  const playBtn = player?.querySelector('[data-toggle]');

  if (player && audio instanceof HTMLAudioElement && playBtn) {
    audio.volume = 0.55;

    const render = () => {
      const playing = !audio.paused;
      player.classList.toggle('is-playing', playing);
      playBtn.setAttribute('aria-pressed', String(playing));
      playBtn.setAttribute(
        'aria-label',
        `${playing ? 'Pause' : 'Play'} ${audio.dataset.title ?? 'music'}`,
      );
    };

    playBtn.addEventListener('click', () => {
      if (audio.paused) {
        // Browsers reject playback without a user gesture; this click is one,
        // but a rejection can still happen (e.g. the file failed to load).
        audio.play().catch(() => render());
      } else {
        audio.pause();
      }
    });

    audio.addEventListener('play', render);
    audio.addEventListener('pause', render);
    render();
  }

  if (nav) {
    // Swap the transparent hero header for the solid bar just after the fold.
    const onScroll = () => {
      nav.classList.toggle('is-scrolled', window.scrollY > 40);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
