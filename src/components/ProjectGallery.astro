---
import { Image } from 'astro:assets';
import { captionFor, type AlbumImage } from '../lib/projects';

interface Props {
  images: AlbumImage[];
  title: string;
  captions?: Record<string, string>;
}

const { images, title, captions = {} } = Astro.props;

// Frame follows the first image's aspect ratio, so the common case of a
// consistent album never letterboxes; odd sizes fall back to `contain`.
const first = images[0]?.image;
const ratio = first ? first.width / first.height : 4 / 3;
---

{
  images.length > 0 && (
    <figure class="gal" data-gallery style={`--gal-ratio: ${ratio.toFixed(4)}`}>
      <div class="gal__stage">
        {images.map(({ image, stem }, i) => {
          const caption = captionFor(stem, captions);
          return (
            <div class="gal__slide" data-slide={i} aria-hidden={i === 0 ? 'false' : 'true'}>
              <Image
                src={image}
                alt={caption ?? `${title} — photo ${i + 1} of ${images.length}`}
                widths={[640, 960, 1280, 1600]}
                sizes="(max-width: 820px) 100vw, 780px"
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
              {caption && <p class="gal__caption">{caption}</p>}
            </div>
          );
        })}

        {images.length > 1 && (
          <>
            <button class="gal__nav gal__nav--prev" type="button" aria-label="Previous photo" data-prev>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M15 4 L7 12 L15 20" fill="none" stroke="currentColor" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
            <button class="gal__nav gal__nav--next" type="button" aria-label="Next photo" data-next>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M9 4 L17 12 L9 20" fill="none" stroke="currentColor" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
          </>
        )}
      </div>

      {images.length > 1 && (
        <figcaption class="gal__bar">
          <span class="gal__count" role="status" aria-live="polite" data-count>
            1 / {images.length}
          </span>

          <div class="gal__dots" role="group" aria-label="Choose photo">
            {images.map((_, i) => (
              <button
                class="gal__dot"
                type="button"
                aria-label={`Photo ${i + 1}`}
                data-dot={i}
              />
            ))}
          </div>
        </figcaption>
      )}
    </figure>
  )
}

<style>
  .gal { margin: 0 0 clamp(2.5rem, 6vw, 4rem); }

  .gal__stage {
    position: relative;
    aspect-ratio: var(--gal-ratio, 4 / 3);
    background: var(--bg-alt);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius);
    overflow: hidden;
  }

  /* Slides stack; only the active one is painted. Cross-fading avoids the
     wrap-around jump a translating track has when looping past the ends. */
  .gal__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s var(--ease), visibility 0.35s var(--ease);
  }

  .gal__slide[aria-hidden='false'] {
    opacity: 1;
    visibility: visible;
  }

  .gal__slide :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Caption rides the bottom of the photo and fades up as its slide
     becomes active, so it reads as a beat after the image lands. */
  .gal__caption {
    position: absolute;
    inset: auto 0 0;
    margin: 0;
    padding: 2.5rem 1.15rem 1rem;
    color: #fff;
    font-size: var(--step--1);
    line-height: 1.4;
    text-wrap: pretty;
    background: linear-gradient(rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.72));
    opacity: 0;
    translate: 0 10px;
    transition:
      opacity 0.4s 0.12s var(--ease),
      translate 0.4s 0.12s var(--ease);
  }

  .gal__slide[aria-hidden='false'] .gal__caption {
    opacity: 1;
    translate: 0 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .gal__caption { transition: none; }
  }

  .gal__nav {
    position: absolute;
    top: 50%;
    translate: 0 -50%;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    color: var(--text);
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(6px);
    border: 1px solid var(--line);
    border-radius: 50%;
    cursor: pointer;
    transition: background-color 0.2s var(--ease), scale 0.2s var(--ease);
  }

  @supports (-webkit-backdrop-filter: blur(1px)) {
    /* Caption rides the bottom of the photo and fades up as its slide
     becomes active, so it reads as a beat after the image lands. */
  .gal__caption {
    position: absolute;
    inset: auto 0 0;
    margin: 0;
    padding: 2.5rem 1.15rem 1rem;
    color: #fff;
    font-size: var(--step--1);
    line-height: 1.4;
    text-wrap: pretty;
    background: linear-gradient(rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.72));
    opacity: 0;
    translate: 0 10px;
    transition:
      opacity 0.4s 0.12s var(--ease),
      translate 0.4s 0.12s var(--ease);
  }

  .gal__slide[aria-hidden='false'] .gal__caption {
    opacity: 1;
    translate: 0 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .gal__caption { transition: none; }
  }

  .gal__nav { -webkit-backdrop-filter: blur(6px); }
  }

  .gal__nav:hover { background: #fff; scale: 1.06; }
  .gal__nav svg { width: 18px; height: 18px; }
  .gal__nav--prev { left: 0.85rem; }
  .gal__nav--next { right: 0.85rem; }

  .gal__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.9rem;
  }

  .gal__count {
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
  }

  .gal__dots {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .gal__dot {
    width: 7px;
    height: 7px;
    padding: 0;
    background: var(--line);
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    transition: background-color 0.2s var(--ease), scale 0.2s var(--ease);
  }

  .gal__dot:hover { background: var(--text-muted); }

  .gal__dot[aria-current='true'] {
    background: var(--text);
    scale: 1.3;
  }

  @media (max-width: 560px) {
    /* Caption rides the bottom of the photo and fades up as its slide
     becomes active, so it reads as a beat after the image lands. */
  .gal__caption {
    position: absolute;
    inset: auto 0 0;
    margin: 0;
    padding: 2.5rem 1.15rem 1rem;
    color: #fff;
    font-size: var(--step--1);
    line-height: 1.4;
    text-wrap: pretty;
    background: linear-gradient(rgba(0, 0, 0, 0), rgba(0, 0, 0, 0.72));
    opacity: 0;
    translate: 0 10px;
    transition:
      opacity 0.4s 0.12s var(--ease),
      translate 0.4s 0.12s var(--ease);
  }

  .gal__slide[aria-hidden='false'] .gal__caption {
    opacity: 1;
    translate: 0 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .gal__caption { transition: none; }
  }

  .gal__nav { width: 34px; height: 34px; }
    .gal__nav--prev { left: 0.5rem; }
    .gal__nav--next { right: 0.5rem; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const slides = [...gallery.querySelectorAll<HTMLElement>('[data-slide]')];
    if (slides.length < 2) return;

    const dots = [...gallery.querySelectorAll<HTMLElement>('[data-dot]')];
    const count = gallery.querySelector<HTMLElement>('[data-count]');
    let index = 0;

    const show = (next: number) => {
      // Modulo wraps in both directions, so the album loops endlessly.
      index = ((next % slides.length) + slides.length) % slides.length;

      slides.forEach((slide, i) => {
        slide.setAttribute('aria-hidden', String(i !== index));
      });
      dots.forEach((dot, i) => {
        dot.setAttribute('aria-current', String(i === index));
      });
      if (count) count.textContent = `${index + 1} / ${slides.length}`;
    };

    gallery.querySelector('[data-prev]')?.addEventListener('click', () => show(index - 1));
    gallery.querySelector('[data-next]')?.addEventListener('click', () => show(index + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => show(i)));

    // Arrow keys work once any control inside the gallery has focus.
    gallery.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowLeft') { event.preventDefault(); show(index - 1); }
      if (event.key === 'ArrowRight') { event.preventDefault(); show(index + 1); }
    });

    // Horizontal swipe on touch devices.
    let startX = 0;
    let tracking = false;

    gallery.addEventListener('touchstart', (event) => {
      startX = event.changedTouches[0].screenX;
      tracking = true;
    }, { passive: true });

    gallery.addEventListener('touchend', (event) => {
      if (!tracking) return;
      tracking = false;
      const delta = event.changedTouches[0].screenX - startX;
      if (Math.abs(delta) > 45) show(index + (delta < 0 ? 1 : -1));
    }, { passive: true });

    show(0);
    dots[0]?.setAttribute('aria-current', 'true');
  });
</script>
