---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { formatYears, coverFor } from '../lib/projects';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, summary, goal, tags, cover, video } = project.data;
const years = formatYears(project.data);
// First album image wins unless the front matter promotes another one;
// `cover` in front matter is the fallback.
const poster = coverFor(project.id, {
  coverIsLogo: project.data.coverIsLogo,
  coverStem: project.data.coverStem,
});
const href = `/projects/${project.id}/`;
---

<article class="card reveal">
  <a class="card__link" href={href}>
    <div class="card__media">
      {
        video ? (
          <video
            class="card__asset"
            poster={poster?.src ?? cover}
            muted
            loop
            playsinline
            preload="none"
            aria-hidden="true"
            tabindex="-1"
            data-hover-video
          >
            <source src={video} type="video/mp4" />
          </video>
        ) : poster ? (
          <Image
            class="card__asset"
            src={poster}
            alt=""
            widths={[320, 480, 720]}
            sizes="(max-width: 720px) 100vw, 360px"
            loading="lazy"
            decoding="async"
          />
        ) : cover ? (
          <img class="card__asset" src={cover} alt="" loading="lazy" decoding="async" />
        ) : (
          <div class="card__asset card__asset--empty" aria-hidden="true" />
        )
      }
    </div>

    <div class="card__body">
      <p class="card__meta">
        <span>{years}</span>
        {goal && <><span aria-hidden="true">&middot;</span><span>{goal}</span></>}
      </p>
      <h3 class="card__title">{title}</h3>
      <p class="card__summary">{summary}</p>

      {
        tags?.length > 0 && (
          <ul class="tags card__tags">
            {tags.slice(0, 4).map((tag) => (
              <li class="tag">{tag}</li>
            ))}
          </ul>
        )
      }

      <span class="link-arrow card__cta">View project</span>
    </div>
  </a>
</article>

<style>
  /* Grid rows stretch, but a block card inside a stretched cell keeps its
     content height — which is what left a card with a shorter summary sitting
     short of its neighbours. Filling the cell and letting the body flex makes
     every card in a row the same box whatever the text length. */
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--bg);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.3s var(--ease), transform 0.3s var(--ease),
      box-shadow 0.3s var(--ease);
  }

  .card:hover {
    border-color: var(--line);
    transform: translateY(-3px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.07);
  }

  .card__link {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  /* flex: none so the media keeps its ratio instead of being squeezed to make
     room for a long summary. */
  .card__media {
    flex: none;
    aspect-ratio: 16 / 10;
    background: var(--bg-alt);
    overflow: hidden;
  }

  .card__asset {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 0.5s var(--ease);
  }

  .card:hover .card__asset { scale: 1.03; }

  .card__asset--empty {
    background:
      repeating-linear-gradient(
        45deg,
        var(--bg-alt) 0 12px,
        #ededf0 12px 24px
      );
  }

  .card__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 1.4rem 1.5rem 1.6rem;
  }

  .card__meta {
    display: flex;
    gap: 0.5em;
    margin: 0 0 0.6em;
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .card__title {
    margin-bottom: 0.4em;
    font-size: var(--step-1);
  }

  .card__summary {
    margin-bottom: 1.1em;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .card__tags { margin-bottom: 1.2em; }

  /* Pushed to the bottom of the body, so the CTA lines up across a row
     instead of floating wherever the summary happens to end. */
  .card__cta {
    margin-top: auto;
    font-weight: 700;
  }
</style>

<script>
  // Preview clips stay unloaded (preload="none") until the pointer lands on the
  // card, so a long projects grid does not pull down every video at once.
  document.querySelectorAll<HTMLElement>('[data-hover-video]').forEach((video) => {
    if (!(video instanceof HTMLVideoElement)) return;

    const card = video.closest('.card');
    if (!card) return;

    card.addEventListener('pointerenter', () => {
      video.play().catch(() => {});
    });

    card.addEventListener('pointerleave', () => {
      video.pause();
      video.currentTime = 0;
    });
  });
</script>
