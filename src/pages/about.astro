---
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import VideoHero from '../components/VideoHero.astro';
import { SITE } from '../site';
import bioPhoto from '../assets/werdnaaa-bio.jpg';
import jewelVortex from '../assets/jewel-singapore-vortex.jpg';
import { existsSync } from 'node:fs';
import { join } from 'node:path';

// min() so a source narrower than 1920 is never upscaled.
const heroBg = await getImage({
  src: bioPhoto,
  width: Math.min(1920, bioPhoto.width),
  format: 'webp',
  quality: 65,
});

// Same Jewel Changi shot as the home page, at the same 62% darkening.
const workBg = await getImage({
  src: jewelVortex,
  width: 1920,
  format: 'webp',
  quality: 60,
});

/**
 * Drop a logo into public/img/logos/ named after `slug` and it appears
 * automatically — any of these extensions works, checked in order of
 * preference. Until then each entry falls back to an initials monogram, so
 * the layout is finished before the artwork is.
 */
const findLogo = (slug: string) => {
  for (const ext of ['svg', 'png', 'webp', 'jpg', 'avif']) {
    const rel = `/img/logos/${slug}.${ext}`;
    if (existsSync(join(process.cwd(), 'public', rel))) return rel;
  }
  return null;
};

const initials = (name: string) =>
  name
    .replace(/[^A-Za-zÀ-ÿ ]/g, ' ')
    .split(/\s+/)
    .filter((w) => w.length > 2)
    .slice(0, 2)
    .map((w) => w[0]?.toUpperCase())
    .join('');

// Placeholder dates and bullets — replace with your own.
const education = [
  {
    slug: 'michigan',
    school: 'University of Michigan Ann Arbor',
    award: 'BSE Aerospace Engineering',
    period: 'Aug 2022 - Apr 2026',
    points: [
      'Focus: Aerospace Structures, Fluid Mechanics',
      'Design of Sub-250g Rocket FPV Drone',
    ],
  },
  {
    slug: 'tu-berlin',
    school: 'Technische Universität Berlin',
    award: 'Research Exchange Programme',
    period: 'May 2024 - Jul 2024',
    points: [
      'Fluid Dynamics and Wind Tunnel Research',
      'Proficiency in Star-CCM+ simulation',
    ],
  },
  {
    slug: 'raffles',
    school: 'Raffles Institution',
    award: 'GCE A-Level Integrated Programme',
    period: 'Jan 2014 - Nov 2019',
    points: [
      'Physics, Chemistry, Math, Economics (AAAA)',
      'Vice-Chairman of the Raffles Players',
    ],
  },
  {
    slug: 'catholic-high',
    school: 'Catholic High School',
    award: 'Primary School Leaving Examination',
    period: 'Jan 2007 - Nov 2013',
    points: [
      'Member of School Debate Team',
      'Member of School Public Speaking Team',
    ],
  },
].map((item) => ({ ...item, logo: findLogo(item.slug), mono: initials(item.school) }));

// Swap these for your own history. Kept as data so the timeline stays tidy.
const timeline = [
  {
    slug: 'changi',
    period: 'Jun 2026 — Present',
    title: 'Mechanical/Robotics Engineer',
    org: 'Changi Airport Group',
    detail: 'Passenger Boarding Bridge management and autonomous drone development',
  },
  {
    slug: 'wet-design',
    period: 'Jun 2025 — Aug 2025',
    title: 'Product Engineer',
    org: 'WET Design Los Angeles',
    detail: 'Underwater mechanical and cable design, rapid iteration for the Saadiyat project',
  },
  {
    slug: 'saf-medical-corps',
    period: 'Jun 2020 — Oct 2021',
    title: 'Combat Medic',
    org: 'Singapore Armed Forces',
    detail: 'Phlebotomy specialist, large-scale vaccine management and deployment in the SAF ',
  },
].map((item) => ({ ...item, logo: findLogo(item.slug), mono: initials(item.org) }));

const skills = [
  { group: 'Engineering', items: ['CAD/FEA (Solidworks, CATIA)', 'PCB Design (KiCAD)', 'Fluid Simulation (Star-CCM+)', '3D Printing (Bambu Lab)'] },
  { group: 'Software', items: ['Embedded C++/Python', 'ROS/ROS2 Framework', 'Betaflight/Ardupilot/PX4', 'DMX Framework (QLC+)'] },
  { group: 'FPV Drones', items: ['Carbon Fiber Frame Design', 'Blackbox PID/Filter Tuning', 'Rapid Build and Repair', 'Video Editing (Hitfilm Pro)'] },
];
---

<Base title="About" description={`About ${SITE.name} — background, skills and where to find me.`} overlayNav>
  <VideoHero
    poster={heroBg.src}
    eyebrow="Introduction"
    title="About Me"
    height="tall"
    align="left"
  />

  <section class="section">
    <div class="wrap bio">
      <div class="bio__text reveal">
        <p class="eyebrow">Bio</p>
        <p class="lede">
          I am an Aerospace Engineering nerd who loves anything that flies. My
          academic journey has taken me from Singapore to the United States,
          where I studied at the University of Michigan Ann Arbor (UofM).
        </p>

        <p>
          At UofM, beyond various theoretical courses on the fundamentals of
          Aerospace Engineering, I gained proficiency in various CAD softwares
          (Solidworks, Fusion360), Finite Element Analysis (CATIA), and
          Computational Fluid Dynamics (Star-CCM+). I also picked up valuable
          mechanical engineering skills such as fabrication experience with 3D
          printing, soldering, spot welding, laser cutting, CNC machining, as
          well as hands-on experience working in large open-loop wind tunnels.
        </p>

        <p>
          My prior internship experience includes stints at the Los
          Angeles-based water engineering firm WET Design (where I did CAD work
          on mechanical underwater components and cables for large-scale
          fountain displays) and at Germany's Technische Universität Berlin
          (where I conducted simple fluid dynamics simulations and research to
          improve the aerodynamic efficiency of a Mercedes A-Class hatchback).
        </p>

        <p>
          Today, I work at Changi Airport Group Singapore as a Senior Associate
          Engineer in the Passenger Boarding Bridge (PBB) Team. I am also involved
          in autonomous drone development to secure our airport's success as the
          high-tech, low-manpower aerodrome of the future.
        </p>

        <p>
          Outside the workplace, I am a passionate maker who loves to tinker
          with mechatronics, robotics, and anything that moves or flies. My
          engineering hobbies include professional FPV drone racing (top-ranked
          Singapore pilot and 2026 Canadian Champion in the micro drone racing
          category), 3D printing, fabricating complex musical fountain displays,
          and nature photography. Beyond my homemade musical fountain show,
          which is the crown jewel of my after-hours engineering efforts, I've
          also completed numerous other small projects, including a powerful
          handheld electric fan, a micro hovercraft vehicle, a 5.8GHz signal
          jammer, custom drones ranging from 2" micros to 7" beasts, and many
          more. I also run the YouTube channel Werdna FPV, which has accrued
          over 800,000 views and 3,700+ subscribers to date.
        </p>

        <p>
        I have numerous other interests that would be too lengthy to document
        here, but among other things, I am an avid nature photographer shooting
        with Sony mirrorless, an avid fan of the K-POP group NewJeans, and particularly
        interested in the field of Christian apologetics and the intersection of scienc
        and religion!
        </p>

      </div>

      <aside class="bio__side reveal">
        <div class="panel">
          <h2 class="panel__title">Location</h2>
          <p class="panel__value">{SITE.location}</p>

          <h2 class="panel__title panel__title--spaced">Social Media</h2>
          <ul class="social">
            {SITE.socials.map((s) => (
              <li>
                <a class="link-arrow" href={s.href} rel="me noopener" target="_blank">{s.label}</a>
              </li>
            ))}
          </ul>

          <h2 class="panel__title panel__title--spaced">Education</h2>
          <ol class="edu">
            {education.map((item) => (
              <li class="edu__item">
                <div class="edu__head">
                  <span class="edu__logo">
                    {item.logo ? (
                      <img src={item.logo} alt="" loading="lazy" decoding="async" />
                    ) : (
                      <span class="edu__mono" aria-hidden="true">{item.mono}</span>
                    )}
                  </span>

                  <span class="edu__id">
                    <span class="edu__school">{item.school}</span>
                    <span class="edu__period">{item.period}</span>
                  </span>
                </div>

                <p class="edu__award">{item.award}</p>

                <ul class="edu__points">
                  {item.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              </li>
            ))}
          </ol>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section--photo" style={`--photo: url('${workBg.src}')`}>
    <div class="wrap">
      <p class="eyebrow reveal">Where I have been</p>
      <h2 class="reveal">Work Experience</h2>

      <ol class="timeline">
        {timeline.map((item) => (
          <li class="timeline__item reveal">
            <p class="timeline__period">{item.period}</p>

            <div class="timeline__body">
              <h3 class="timeline__title">{item.title}</h3>
              <p class="timeline__org">{item.org}</p>
              <p class="muted">{item.detail}</p>
            </div>

            <span class="timeline__logo">
              {item.logo ? (
                <img src={item.logo} alt="" loading="lazy" decoding="async" />
              ) : (
                <span class="timeline__mono" aria-hidden="true">{item.mono}</span>
              )}
            </span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <p class="eyebrow reveal">My Toolkit</p>
      <h2 class="reveal">Skills and Proficiencies</h2>

      <div class="grid grid--3 skills">
        {skills.map((skill) => (
          <div class="reveal">
            <h3 class="skills__group">{skill.group}</h3>
            <ul class="skills__list">
              {skill.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .bio {
    display: grid;
    gap: clamp(2rem, 5vw, 4rem);
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    align-items: start;
  }

  @media (max-width: 860px) {
    .bio { grid-template-columns: 1fr; }
  }

  .bio__text { max-width: var(--measure); }
  .bio__text .lede { margin-bottom: 1.6em; }

  /* Justified body copy. Hyphenation is not optional here — without it the
     browser stretches word spacing to fill each line and carves white
     "rivers" down the column. Needs lang="en" on <html>, which Base sets. */
  .bio__text p:not(.eyebrow) {
    margin-bottom: 1.5em;
    text-align: justify;
    hyphens: auto;
  }

  /* Safari below 17 only understands the prefixed property, and a plain
     duplicate declaration gets pruned by the CSS minifier. */
  @supports (-webkit-hyphens: auto) {
    .bio__text p:not(.eyebrow) { -webkit-hyphens: auto; }
  }

  /* Narrow columns cannot justify without huge gaps between words. */
  @media (max-width: 620px) {
    .bio__text p:not(.eyebrow) {
      text-align: left;
      hyphens: manual;
    }

    @supports (-webkit-hyphens: auto) {
      .bio__text p:not(.eyebrow) { -webkit-hyphens: manual; }
    }
  }

  .bio__list {
    margin: 0 0 1.5em;
    padding-left: 1.4em;
    display: grid;
    gap: 0.6rem;
  }

  .bio__list li { padding-left: 0.3em; }

  /* Not sticky: with the education list the panel is taller than the
     viewport, and a sticky element that overflows strands its own footer. */
  .panel {
    padding: clamp(1.5rem, 3vw, 2rem);
    background: var(--bg-alt);
    border: 1px solid var(--line-soft);
    border-radius: var(--radius);
  }

  .panel__title {
    margin-bottom: 0.8em;
    font-size: var(--step--1);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .panel__title--spaced { margin-top: 2em; }

  .panel__value {
    margin: 0;
    word-break: break-word;
  }

  .social {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.6rem;
  }

  /* ---- Work experience on a photo backdrop ---- */

  .section--photo {
    background-image:
      linear-gradient(rgba(0, 0, 0, 0.62), rgba(0, 0, 0, 0.62)),
      var(--photo);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    color: var(--text-inverse);
  }

  .section--photo .eyebrow { color: rgba(245, 245, 247, 0.72); }
  .section--photo .muted { color: rgba(245, 245, 247, 0.78); }

  /* Hairlines tuned for the dark ground — var(--line) all but vanishes. */
  .section--photo .timeline__item {
    border-top-color: rgba(255, 255, 255, 0.18);
  }

  .section--photo .timeline__item:last-child {
    border-bottom-color: rgba(255, 255, 255, 0.18);
  }

  .section--photo .timeline__period,
  .section--photo .timeline__org {
    color: rgba(245, 245, 247, 0.72);
  }

  /* The white logo tiles already read correctly here, so they stay as-is. */
  .section--photo .timeline__logo {
    border-color: rgba(255, 255, 255, 0.25);
  }

  /* ---- Education ---- */

  .edu {
    /* One card per institution, sitting on the lighter panel behind them. */
    --edu-card: #e7e7ec;
    --edu-ink: #56565b;

    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.7rem;
  }

  .edu__item {
    padding: 1rem 1.05rem 1.1rem;
    background: var(--edu-card);
    border-radius: var(--radius);
  }

  .edu__head {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-bottom: 0.85em;
  }

  /* White tile so dark-on-transparent logos keep their contrast against the
     darker card. Fixed square keeps every row aligned whatever shape it is. */
  .edu__logo {
    flex: none;
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    padding: 5px;
    background: #fff;
    border-radius: var(--radius);
    overflow: hidden;
  }

  .edu__logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .edu__mono {
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }

  .edu__id {
    display: grid;
    gap: 0.2em;
    min-width: 0;
  }

  .edu__school {
    font-size: var(--step-0);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .edu__period {
    font-size: var(--step--1);
    color: var(--edu-ink);
  }

  .edu__award {
    margin: 0 0 0.7em;
    padding-bottom: 0.7em;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--text);
  }

  .edu__points {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.4rem;
    font-size: var(--step--1);
    line-height: 1.45;
    color: var(--edu-ink);
  }

  .edu__points li {
    position: relative;
    padding-left: 0.95em;
  }

  .edu__points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.58em;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #a5a5ac;
  }

  .timeline {
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    padding: 0;
    list-style: none;
  }

  .timeline__item {
    display: grid;
    grid-template-columns: minmax(0, 200px) minmax(0, 1fr) auto;
    align-items: start;
    gap: clamp(1rem, 4vw, 3rem);
    padding: clamp(1.5rem, 3vw, 2.2rem) 0;
    border-top: 1px solid var(--line);
  }

  .timeline__item:last-child { border-bottom: 1px solid var(--line); }

  /* White tile, sized to the row, holding the employer mark. */
  .timeline__logo {
    flex: none;
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    padding: 10px;
    background: #fff;
    border: 1px solid var(--line-soft);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .timeline__logo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .timeline__mono {
    font-size: var(--step-0);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }

  @media (max-width: 860px) {
    .timeline__logo { width: 60px; height: 60px; padding: 8px; }
  }

  /* Single column: date and logo share the top row, copy below spans both. */
  @media (max-width: 640px) {
    .timeline__item {
      grid-template-columns: 1fr auto;
      gap: 0.75rem 1rem;
    }

    .timeline__period {
      grid-column: 1;
      grid-row: 1;
      align-self: center;
    }

    .timeline__logo {
      grid-column: 2;
      grid-row: 1;
      width: 52px;
      height: 52px;
      padding: 7px;
    }

    .timeline__body {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }

  .timeline__period {
    margin: 0;
    font-size: var(--step--1);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .timeline__title { margin-bottom: 0.15em; }

  .timeline__org {
    margin-bottom: 0.6em;
    color: var(--text-muted);
  }

  .skills { margin-top: clamp(2rem, 4vw, 3rem); }

  .skills__group {
    padding-bottom: 0.7em;
    margin-bottom: 0.9em;
    border-bottom: 1px solid var(--line);
    font-size: var(--step-0);
    letter-spacing: 0.04em;
  }

  .skills__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
    color: var(--text-muted);
  }
</style>
