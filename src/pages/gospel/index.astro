---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import VideoHero from '../../components/VideoHero.astro';

const posts = (await getCollection('gospel', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const fmt = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});

/** Strip markdown syntax so the search index is plain prose. */
const plain = (md: string) =>
  md
    .replace(/```[\s\S]*?```/g, ' ')
    .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
    .replace(/[#>*_`~\-]+/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

const words = (md: string) => plain(md).split(' ').filter(Boolean).length;

// One searchable blob per post: title, summary, tags and body. Capped so a
// long archive does not bloat the HTML.
const indexed = posts.map((post) => ({
  post,
  minutes: post.data.readingTime ?? Math.max(1, Math.round(words(post.body ?? '') / 200)),
  haystack: [
    post.data.title,
    post.data.summary,
    post.data.scripture ?? '',
    post.data.tags.join(' '),
    plain(post.body ?? '').slice(0, 3000),
  ]
    .join(' ')
    .toLowerCase(),
}));

const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

<Base
  title="The Gospel"
  description="Writing on Christianity and apologetics — the resurrection, the existence of God, science and faith."
  overlayNav
>
  <VideoHero
    eyebrow="The Gospel"
    title="Faith, worth thinking about"
    subtitle="Writing on Christianity and apologetics — placeholder, to be replaced."
    height="tall"
    align="left"
  />

  <section class="section">
    <div class="wrap">
      <div class="tools reveal">
        <div class="search">
          <label class="sr-only" for="post-search">Search posts by keyword</label>
          <svg class="search__icon" viewBox="0 0 20 20" aria-hidden="true">
            <circle cx="9" cy="9" r="6" fill="none" stroke="currentColor" stroke-width="2" />
            <path d="M13.5 13.5 L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
          <input
            class="search__input"
            id="post-search"
            type="search"
            autocomplete="off"
            placeholder="Search — resurrection, evolution, quantum physics…"
            data-search
          />
          <button class="search__clear" type="button" data-clear hidden aria-label="Clear search">
            &times;
          </button>
        </div>

        {
          tags.length > 0 && (
            <div class="chips" role="group" aria-label="Filter by topic">
              <button class="chip is-active" type="button" data-tag="all">
                All topics
              </button>
              {tags.map((tag) => (
                <button class="chip" type="button" data-tag={tag}>
                  {tag}
                </button>
              ))}
            </div>
          )
        }

        <p class="count" role="status" aria-live="polite" data-count></p>
      </div>

      <div class="posts" data-list>
        {
          indexed.map(({ post, minutes, haystack }) => (
            <article
              class="post reveal"
              data-tags={post.data.tags.join('|')}
              data-haystack={haystack}
            >
              <a class="post__link" href={`/gospel/${post.id}/`}>
                <p class="post__meta">
                  <time datetime={post.data.date.toISOString()}>
                    {fmt.format(post.data.date)}
                  </time>
                  <span aria-hidden="true">&middot;</span>
                  <span>{minutes} min read</span>
                </p>

                <h2 class="post__title">{post.data.title}</h2>
                <p class="post__summary">{post.data.summary}</p>

                {post.data.scripture && (
                  <p class="post__scripture">{post.data.scripture}</p>
                )}

                {post.data.tags.length > 0 && (
                  <ul class="tags post__tags">
                    {post.data.tags.map((tag) => (
                      <li class="tag">{tag}</li>
                    ))}
                  </ul>
                )}

                <span class="link-arrow post__cta">Read</span>
              </a>
            </article>
          ))
        }
      </div>

      <p class="empty" hidden data-empty>
        No posts match that search. Try a different keyword or clear the filters.
      </p>

      {
        posts.length === 0 && (
          <p class="muted">
            No posts yet — add a markdown file to <code>src/content/gospel/</code>.
          </p>
        )
      }
    </div>
  </section>
</Base>

<style>
  .tools {
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
    padding-bottom: clamp(1.5rem, 3vw, 2rem);
    border-bottom: 1px solid var(--line-soft);
  }

  .search {
    position: relative;
    display: flex;
    align-items: center;
    max-width: 560px;
    margin-bottom: 1.5rem;
  }

  .search__icon {
    position: absolute;
    left: 1rem;
    width: 18px;
    height: 18px;
    color: var(--text-muted);
    pointer-events: none;
  }

  .search__input {
    width: 100%;
    padding: 0.85em 2.75rem;
    font-family: inherit;
    font-size: var(--step-0);
    color: var(--text);
    background: var(--bg-alt);
    border: 1px solid var(--line);
    border-radius: 100px;
    transition: border-color 0.2s var(--ease), background-color 0.2s var(--ease);
  }

  .search__input::placeholder { color: var(--text-muted); }

  .search__input:focus {
    outline: none;
    background: var(--bg);
    border-color: var(--text);
  }

  /* The native clear affordance duplicates our own button. */
  .search__input::-webkit-search-cancel-button { display: none; }

  .search__clear {
    position: absolute;
    right: 0.9rem;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    font-size: 1.25rem;
    line-height: 1;
    color: var(--text-muted);
    background: none;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
  }

  .search__clear:hover { color: var(--text); }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .chip {
    padding: 0.42em 1.05em;
    background: none;
    border: 1px solid var(--line);
    border-radius: 100px;
    font-family: inherit;
    font-size: var(--step--1);
    color: var(--text-muted);
    cursor: pointer;
    transition: background-color 0.22s var(--ease), color 0.22s var(--ease),
      border-color 0.22s var(--ease);
  }

  .chip:hover { border-color: var(--text); color: var(--text); }

  .chip.is-active {
    background: var(--text);
    border-color: var(--text);
    color: var(--bg);
  }

  .count {
    margin: 1.25rem 0 0;
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .posts { display: grid; gap: 0; }

  .post { border-bottom: 1px solid var(--line-soft); }
  .post:first-child { border-top: 1px solid var(--line-soft); }
  .post[hidden] { display: none; }

  .post__link {
    display: block;
    padding: clamp(1.5rem, 3vw, 2.25rem) 0;
    transition: opacity 0.2s var(--ease);
  }

  .post__link:hover { opacity: 0.72; }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5em;
    margin: 0 0 0.5em;
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .post__title {
    max-width: 28ch;
    margin-bottom: 0.35em;
    font-size: var(--step-2);
    text-wrap: balance;
  }

  .post__summary {
    max-width: var(--measure);
    margin-bottom: 0.9em;
    color: var(--text-muted);
    text-wrap: pretty;
  }

  .post__scripture {
    margin-bottom: 1em;
    padding-left: 0.9em;
    border-left: 2px solid var(--line);
    font-style: italic;
    color: var(--text-muted);
  }

  .post__tags { margin-bottom: 1em; }
  .post__cta { font-weight: 700; }

  .empty {
    margin-top: 2.5rem;
    color: var(--text-muted);
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.92em;
  }
</style>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-search]');
  const clear = document.querySelector<HTMLButtonElement>('[data-clear]');
  const chips = document.querySelectorAll<HTMLButtonElement>('[data-tag]');
  const posts = document.querySelectorAll<HTMLElement>('.post[data-haystack]');
  const count = document.querySelector<HTMLElement>('[data-count]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');

  let query = '';
  let tag = 'all';

  const apply = () => {
    // Every whitespace-separated term must appear, so extra words narrow the
    // results rather than widening them.
    const terms = query.split(/\s+/).filter(Boolean);
    let shown = 0;

    posts.forEach((post) => {
      const tags = (post.dataset.tags ?? '').split('|');
      const haystack = post.dataset.haystack ?? '';

      const tagOk = tag === 'all' || tags.includes(tag);
      const textOk = terms.every((t) => haystack.includes(t));
      const match = tagOk && textOk;

      post.hidden = !match;
      if (match) shown += 1;
    });

    if (empty) empty.hidden = shown !== 0 || posts.length === 0;
    if (clear) clear.hidden = query === '';

    if (count) {
      const total = posts.length;
      count.textContent =
        query === '' && tag === 'all'
          ? `${total} post${total === 1 ? '' : 's'}`
          : `${shown} of ${total} post${total === 1 ? '' : 's'}`;
    }
  };

  input?.addEventListener('input', () => {
    query = input.value.trim().toLowerCase();
    apply();
  });

  clear?.addEventListener('click', () => {
    if (!input) return;
    input.value = '';
    query = '';
    input.focus();
    apply();
  });

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      tag = chip.dataset.tag ?? 'all';
      chips.forEach((c) => c.classList.toggle('is-active', c === chip));
      apply();
    });
  });

  // Escape clears the field while it has focus.
  input?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && input.value !== '') {
      event.preventDefault();
      clear?.click();
    }
  });

  apply();
</script>
