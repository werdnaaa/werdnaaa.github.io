---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import VideoHero from '../../components/VideoHero.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { sortProjects } from '../../lib/projects';
import dronePhoto from '../../assets/werdnaaa-autonomous-drone.jpg';

// min() so a source narrower than 1920 is never upscaled.
const heroBg = await getImage({
  src: dronePhoto,
  width: Math.min(1920, dronePhoto.width),
  format: 'webp',
  quality: 65,
});

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  sortProjects,
);

// Build the filter bar from whatever tags actually exist in the content.
const tags = [...new Set(projects.flatMap((p) => p.data.tags))].sort();
---

<Base
  title="My Projects"
  description="Everything from a Custom Hovercraft to an 80 Watt Handheld Fan to a 290km/h Sub-250g Rocket Drone"
  overlayNav
>
  <VideoHero
    poster={heroBg.src}
    dim={0.5}
    eyebrow="What I've Been Cooking"
    title="My Projects"
    subtitle="Everything from a Custom Hovercraft to an 80 Watt Handheld Fan to a 290km/h Sub-250g Rocket Drone"
    height="tall"
    align="left"
  />

  <section class="section">
    <div class="wrap">
      {
        tags.length > 0 && (
          <div class="filters reveal" role="group" aria-label="Filter projects by tag">
            <button class="chip is-active" type="button" data-filter="all">
              All <span class="chip__count">{projects.length}</span>
            </button>
            {tags.map((tag) => (
              <button class="chip" type="button" data-filter={tag}>
                {tag}
              </button>
            ))}
          </div>
        )
      }

      <div class="grid grid--3" data-project-grid>
        {projects.map((project) => (
          <div class="cell" data-tags={project.data.tags.join('|')}>
            <ProjectCard project={project} />
          </div>
        ))}
      </div>

      <p class="empty" hidden data-empty>No projects match that filter.</p>

      {
        projects.length === 0 && (
          <p class="muted">
            No projects yet — add a markdown file to <code>src/content/projects/</code>.
          </p>
        )
      }
    </div>
  </section>
</Base>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
    padding-bottom: clamp(1.5rem, 3vw, 2rem);
    border-bottom: 1px solid var(--line-soft);
  }

  .chip {
    padding: 0.42em 1.05em;
    background: none;
    border: 1px solid var(--line);
    border-radius: 100px;
    font-family: inherit;
    font-size: var(--step--1);
    color: var(--text-muted);
    cursor: pointer;
    transition: background-color 0.22s var(--ease), color 0.22s var(--ease),
      border-color 0.22s var(--ease);
  }

  .chip:hover { border-color: var(--text); color: var(--text); }

  .chip.is-active {
    background: var(--text);
    border-color: var(--text);
    color: var(--bg);
  }

  .chip__count {
    margin-left: 0.35em;
    opacity: 0.6;
  }

  /* Three across at most, so a fourth project starts a new row rather than
     squeezing the row into four narrow cards on a wide screen. Capped here
     rather than on .grid--3, which other pages share. Below this width the
     utility's own auto-fit handles the drop to two columns and then one. */
  @media (min-width: 1000px) {
    [data-project-grid] { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  .cell[hidden] { display: none; }

  .empty {
    margin-top: 2rem;
    color: var(--text-muted);
  }

  code {
    font-family: var(--font-mono);
    font-size: 0.92em;
  }
</style>

<script>
  const chips = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cells = document.querySelectorAll<HTMLElement>('.cell[data-tags]');
  const empty = document.querySelector<HTMLElement>('[data-empty]');

  chips.forEach((chip) => {
    chip.addEventListener('click', () => {
      const filter = chip.dataset.filter;
      chips.forEach((c) => c.classList.toggle('is-active', c === chip));

      let shown = 0;
      cells.forEach((cell) => {
        const tags = (cell.dataset.tags ?? '').split('|');
        const match = filter === 'all' || tags.includes(filter ?? '');
        cell.hidden = !match;
        if (match) shown += 1;
      });

      if (empty) empty.hidden = shown !== 0;
    });
  });
</script>
