---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import VideoHero from '../components/VideoHero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { sortProjects } from '../lib/projects';
import { SITE } from '../site';
import jewelVortex from '../assets/jewel-singapore-vortex.jpg';
import fpvQuad from '../assets/werdnaaa-fpv-quad.jpg';

/**
 * Source photos live in src/assets/ (not public/) so Astro resizes and
 * re-encodes them at build time. The 4000px camera original never ships.
 */
const introBg = await getImage({
  src: jewelVortex,
  width: 1920,
  format: 'webp',
  quality: 60,
});

const contactBg = await getImage({
  src: fpvQuad,
  width: Math.min(1920, fpvQuad.width),
  format: 'webp',
  quality: 66,
});

// Every project, newest first — the rail below shows three at a time and
// scrolls to the rest, so nothing needs to be cut to keep the page tidy.
const featured = (await getCollection('projects', ({ data }) => !data.draft))
  .sort(sortProjects);
---

<Base overlayNav>
  <VideoHero
    src="/video/hero-loop.mp4"
    poster="/posters/hero-loop.webp"
    title="Hi, I'm Andrew!"
    kicker="You may know me as Werdna FPV"
    subtitle={SITE.tagline}
    subtitleNoWrap
    height="full"
  >
    <a class="btn btn--light" href="/about/">About Me</a>
    <a class="btn btn--light" href="/projects/">Engineering Projects</a>
    <a class="btn btn--light" href="/fpv/">FPV Racing</a>
  </VideoHero>

  <section class="section section--photo" style={`--photo: url('${introBg.src}')`}>
    <div class="wrap">
      <div class="intro reveal">
        <p class="eyebrow">Why does this page exist?</p>
        <h2>Why not though?</h2>
        <p class="lede">
          I am an Aerospace Engineering nerd who loves anything that flies!
          I'm currently working at Changi Airport Group.
          In my free time, I pilot FPV racing drones and design musical fountains.
        </p>
        <a class="link-arrow" href="/about/">About Me</a>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <header class="block-head reveal">
        <div>
          <p class="eyebrow">What I've Been Cooking</p>
          <h2>Feature Projects</h2>
        </div>

        <div class="block-head__side">
          <a class="link-arrow" href="/projects/">All projects</a>

          <div class="rail__nav" data-rail-nav hidden>
            <button class="rail__btn" type="button" aria-label="Previous projects" data-rail-prev>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M15 4 L7 12 L15 20" fill="none" stroke="currentColor" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
            <button class="rail__btn" type="button" aria-label="More projects" data-rail-next>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M9 4 L17 12 L9 20" fill="none" stroke="currentColor" stroke-width="2"
                  stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
          </div>
        </div>
      </header>

      <div class="rail reveal" data-rail>
        <div
          class="rail__track"
          data-rail-track
          tabindex="0"
          role="region"
          aria-label="Featured projects"
        >
          {featured.map((project) => (
            <div class="rail__item">
              <ProjectCard project={project} />
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section
    class="section section--deep section--photo section--photo-soft"
    style={`--photo: url('${contactBg.src}')`}
  >
    <div class="wrap cta reveal">
      <p class="eyebrow">A Shameless Plug</p>
      <h2>Werdna FPV YouTube Channel</h2>
      <p class="lede cta__lede">
        My channel focuses on documenting my journey and experiences as a semi-pro FPV drone racing pilot.
        I post vlogs, racing DVR footage, product reviews, and engineering content.
        Please consider subscribing! It's free and you can always change your mind. :D
      </p>
      <a class="btn btn--light" href={SITE.contact.href} rel="noopener" target="_blank">
        {SITE.contact.label}
      </a>
    </div>
  </section>
</Base>

<style>
  /* Photo backdrop. The flat black gradient layer sits above the image in
     the same background shorthand, so compositing black at this alpha scales
     every channel down — 0.62 renders the photo 62% darker. The text on top
     is unaffected (a filter would have dimmed that too). */
  .section--photo {
    background-image:
      linear-gradient(rgba(0, 0, 0, 0.62), rgba(0, 0, 0, 0.62)),
      var(--photo);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    color: var(--text-inverse);
  }

  /* 20% wash for the contact block, as specified. */
  .section--photo-soft {
    background-image:
      linear-gradient(rgba(0, 0, 0, 0.2), rgba(0, 0, 0, 0.2)),
      var(--photo);
  }

  .section--photo .eyebrow { color: rgba(245, 245, 247, 0.72); }
  .section--photo .lede { color: rgba(245, 245, 247, 0.92); }

  .section--photo .link-arrow {
    color: #fff;
    font-weight: 700;
  }

  .intro {
    max-width: 68ch;
  }

  /* Justified, with hyphenation so the browser breaks words instead of
     stretching word spacing into white rivers down the column. */
  .intro p:not(.eyebrow) {
    text-align: justify;
    hyphens: auto;
  }

  @supports (-webkit-hyphens: auto) {
    .intro p:not(.eyebrow) { -webkit-hyphens: auto; }
  }

  /* Too narrow to justify without large word gaps. */
  @media (max-width: 620px) {
    .intro p:not(.eyebrow) {
      text-align: left;
      hyphens: manual;
    }

    @supports (-webkit-hyphens: auto) {
      .intro p:not(.eyebrow) { -webkit-hyphens: manual; }
    }
  }

  .intro h2 {
    margin-bottom: 0.55em;
    text-wrap: balance;
  }

  .intro .lede {
    margin-bottom: 1.4em;
  }

  .block-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.25rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .block-head__side {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  /* ---- Project rail ----
     A scroll-snapped row rather than a wrapping grid: three cards on desktop,
     the rest a scroll away, so adding projects never lengthens the home page.
     Native overflow scrolling means trackpad, touch and keyboard all work
     without JS; the buttons are an affordance on top of that. */
  .rail {
    /* Cards sit flush with the wrap, but the scroll runs past the gutters so
       the next card is not clipped mid-air at the edge of the viewport. */
    margin-inline: calc(var(--gutter) * -1);
  }

  .rail__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - 2 * var(--rail-gap)) / 3);
    gap: var(--rail-gap);
    padding-inline: var(--gutter);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    scroll-behavior: smooth;
    /* The buttons and the card hover lift are the affordance — a scrollbar
       under the cards would just add noise. */
    scrollbar-width: none;
    --rail-gap: clamp(1.25rem, 3vw, 2.5rem);
  }

  .rail__track::-webkit-scrollbar { display: none; }

  .rail__track:focus-visible {
    outline: 2px solid var(--link);
    outline-offset: 4px;
  }

  .rail__item { scroll-snap-align: start; }

  /* Two up on tablets, and just over one on phones — the sliver of the next
     card is what tells you the row scrolls. */
  @media (max-width: 900px) {
    .rail__track { grid-auto-columns: calc((100% - var(--rail-gap)) / 2); }
  }

  @media (max-width: 600px) {
    .rail__track { grid-auto-columns: 82%; }
  }

  .rail__nav {
    display: flex;
    gap: 0.5rem;
  }

  .rail__nav[hidden] { display: none; }

  .rail__btn {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    padding: 0;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 50%;
    cursor: pointer;
    transition: border-color 0.2s var(--ease), background-color 0.2s var(--ease),
      opacity 0.2s var(--ease);
  }

  .rail__btn:hover:not(:disabled) { border-color: var(--text); }
  .rail__btn svg { width: 17px; height: 17px; }

  .rail__btn:disabled {
    opacity: 0.32;
    cursor: default;
  }

  @media (prefers-reduced-motion: reduce) {
    .rail__track { scroll-behavior: auto; }
  }

  .block-head h2 { margin-bottom: 0; }

  /* This block alone is centred — eyebrow, heading, body and button. */
  .cta {
    max-width: 62ch;
    margin-inline: auto;
    text-align: center;
  }

  .cta h2 { text-wrap: balance; }

  /* Justified body, but the last line still centres with the rest of the
     block rather than being flushed left. */
  .cta__lede {
    color: rgba(245, 245, 247, 0.72);
    margin-bottom: 1.8em;
    text-align: justify;
    text-align-last: center;
    hyphens: auto;
  }

  @supports (-webkit-hyphens: auto) {
    .cta__lede { -webkit-hyphens: auto; }
  }

  /* Narrow columns cannot justify without large gaps between words. */
  @media (max-width: 620px) {
    .cta__lede {
      text-align: center;
      hyphens: manual;
    }

    @supports (-webkit-hyphens: auto) {
      .cta__lede { -webkit-hyphens: manual; }
    }
  }
</style>

<script>
  // The rail scrolls natively; this only adds the buttons and keeps their
  // state honest. Everything degrades to a plain scrollable row without JS,
  // which is why the nav ships hidden and is revealed here.
  document.querySelectorAll<HTMLElement>('[data-rail]').forEach((rail) => {
    const track = rail.querySelector<HTMLElement>('[data-rail-track]');
    const nav = document.querySelector<HTMLElement>('[data-rail-nav]');
    const prev = document.querySelector<HTMLButtonElement>('[data-rail-prev]');
    const next = document.querySelector<HTMLButtonElement>('[data-rail-next]');

    if (!track || !nav || !prev || !next) return;

    // One card plus its gap, measured rather than hard-coded, so the same
    // code works across the three breakpoints.
    const step = () => {
      const first = track.firstElementChild as HTMLElement | null;
      if (!first) return track.clientWidth;
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      return first.getBoundingClientRect().width + gap;
    };

    const overflows = () => track.scrollWidth - track.clientWidth > 1;

    const sync = () => {
      // Nothing to scroll to when every card already fits.
      nav.hidden = !overflows();
      // Sub-pixel widths mean the end is never exactly scrollWidth.
      const max = track.scrollWidth - track.clientWidth - 1;
      prev.disabled = track.scrollLeft <= 0;
      next.disabled = track.scrollLeft >= max;
    };

    prev.addEventListener('click', () => track.scrollBy({ left: -step() }));
    next.addEventListener('click', () => track.scrollBy({ left: step() }));

    track.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync, { passive: true });

    sync();
  });
</script>
